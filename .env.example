# Copy this file to .env.local and fill in values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Never expose a Supabase service-role key in NEXT_PUBLIC_* variables or client code.

# Dedicated Supabase test users for tests/security.test.ts.
# Create four non-production accounts: two dealers and two distributor owners.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
TEST_DEALER_A_EMAIL=dealer-a-test@example.com
TEST_DEALER_A_PASSWORD=replace-with-test-password
TEST_DEALER_B_EMAIL=dealer-b-test@example.com
TEST_DEALER_B_PASSWORD=replace-with-test-password
TEST_DISTRIBUTOR_A_EMAIL=distributor-a-test@example.com
TEST_DISTRIBUTOR_A_PASSWORD=replace-with-test-password
TEST_DISTRIBUTOR_B_EMAIL=distributor-b-test@example.com
TEST_DISTRIBUTOR_B_PASSWORD=replace-with-test-password
TEST_DISTRIBUTOR_A_PRODUCT_ID=00000000-0000-4000-8000-000000000000
